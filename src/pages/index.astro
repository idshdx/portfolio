---
import Layout from "../layouts/Layout.astro";
import Home from "../components/home.astro";
import Tech from "../components/tech.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Links from "../components/links.astro";
import Footer from "../components/footer.astro";
import Career from "../components/career.astro";
import Companies from "../components/companies.astro";
import OssProjects from "../components/oss-projects.astro";
import Testimonials from "../components/testimonials.astro";
import Interests from "../components/interests.astro";
import { buildHomeStructuredData, homeDescription, homeTitle } from "../data/site/seo";

interface ProfileData {
  webpageTitle: string;
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData = { webpageTitle: homeTitle };

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
  }
}

const pageTitle = data.webpageTitle?.trim() || homeTitle;
---

<Layout
  title={pageTitle}
  description={homeDescription}
  structuredData={buildHomeStructuredData()}
>
	<Home />
	<Companies />
	<Tech />
	<Career />
	<Projects />
	<OssProjects />
	<Testimonials />
	<Interests />
	<Contact />
	<Links />
	<Footer />
</Layout>
