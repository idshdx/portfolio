---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { ossProjects } from "../../site-data";
import type { OssProject } from "../../site-data";

export async function getStaticPaths() {
  return ossProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: OssProject;
}

const { project } = Astro.props;

// Find next/prev projects for navigation
const currentIndex = ossProjects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? ossProjects[currentIndex - 1] : null;
const nextProject =
  currentIndex < ossProjects.length - 1 ? ossProjects[currentIndex + 1] : null;


---

<Layout title={`${project.title} — Open Source`}>
  <!-- Fixed Back Button -->
  <a
    href="/#open-source"
    id="back-btn"
    aria-label="Back to Open Source Projects"
    class="fixed top-6 left-6 z-50 flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300 hover:text-accent hover:border-accent/40 backdrop-blur-md transition-all duration-300 group"
  >
    <Icon
      name="mdi:arrow-left"
      class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
    />
    <span class="hidden sm:inline">Back to Open Source</span>
  </a>

  <article class="oss-detail-page">
    <!-- ==================== HERO ==================== -->
    <section class="hero-section relative w-full overflow-hidden -mx-2 sm:-mx-12 md:-mx-14 lg:-mx-28">
      <!-- Hero Image or Gradient Fallback -->
      <div class="absolute inset-0 w-full h-full">
        {project.heroImage ? (
          <>
            <img
              src={project.heroImage}
              alt={`${project.title} hero`}
              class="w-full h-full object-cover opacity-40"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-background/60 via-background/80 to-background" />
            <div class="absolute inset-0 bg-gradient-to-r from-accent/10 via-transparent to-accent/5" />
          </>
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-accent/20 via-background to-background" />
        )}
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 max-w-4xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28">

        <h1
          class="cs-reveal text-4xl md:text-6xl lg:text-7xl font-heading font-bold text-white leading-tight mb-6"
          style="animation-delay: 100ms;"
        >
          {project.title}
        </h1>

        <p
          class="cs-reveal text-lg md:text-xl text-gray-300 font-body leading-relaxed max-w-3xl"
          style="animation-delay: 200ms;"
        >
          {project.description}
        </p>

        <!-- Repo / Demo link buttons -->
        <div class="cs-reveal flex flex-wrap gap-4 mt-8" style="animation-delay: 300ms;">
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 rounded-full text-white hover:border-accent/40 hover:bg-accent/10 transition-all duration-300 group"
          >
            <Icon name="mdi:github" class="w-4 h-4" />
            <span class="text-sm font-medium">View Repository</span>
            <Icon
              name="mdi:open-in-new"
              class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
            />
          </a>
          {project.demoUrl && (
            <a
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-accent/10 border border-accent/30 rounded-full text-accent hover:bg-accent/20 hover:border-accent/50 transition-all duration-300 group"
            >
              <span class="text-sm font-medium">Live Demo</span>
              <Icon
                name="mdi:open-in-new"
                class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
              />
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- ==================== OVERVIEW ==================== -->
    <section class="max-w-4xl mx-auto px-4 mt-20 md:mt-28">
      <div class="cs-reveal">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
            <Icon name="mdi:information-outline" class="w-5 h-5 text-blue-400" />
          </div>
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">Overview</h2>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8">
          <p class="text-gray-300 font-body text-base md:text-lg leading-relaxed">
            {project.description}
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== FEATURES ==================== -->
    <section class="max-w-4xl mx-auto px-4 mt-16 md:mt-24">
      <div class="cs-reveal">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
            <Icon name="mdi:check-decagram-outline" class="w-5 h-5 text-emerald-400" />
          </div>
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">Features</h2>
        </div>
      </div>

      <div class="space-y-4">
        {project.features.map((feature, i) => (
          <div
            class="cs-reveal flex gap-4 items-start group"
            style={`animation-delay: ${i * 80}ms;`}
          >
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center mt-0.5 group-hover:bg-accent/20 transition-colors">
              <Icon name="mdi:check" class="w-4 h-4 text-accent" />
            </div>
            <p class="text-gray-300 font-body text-sm md:text-base leading-relaxed">
              {feature}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== TECH STACK ==================== -->
    <section class="max-w-4xl mx-auto px-4 mt-16 md:mt-24">
      <div class="cs-reveal">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center">
            <Icon name="mdi:layers-outline" class="w-5 h-5 text-accent" />
          </div>
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">Tech Stack</h2>
        </div>

        <div class="flex flex-wrap gap-3">
          {project.tech.map((t) => (
            <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-xl text-sm text-gray-300 font-body hover:border-accent/30 hover:text-white transition-all duration-300">
              {t}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== KEY TAKEAWAYS ==================== -->
    {project.keyTakeaways && project.keyTakeaways.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 mt-16 md:mt-24">
        <div class="cs-reveal">
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center">
              <Icon name="mdi:star-outline" class="w-5 h-5 text-yellow-400" />
            </div>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">
              Key Takeaways
            </h2>
          </div>
        </div>

        <div class="space-y-4">
          {project.keyTakeaways.map((takeaway, i) => (
            <div
              class="cs-reveal flex gap-4 items-start group"
              style={`animation-delay: ${i * 80}ms;`}
            >
              <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center mt-0.5 group-hover:bg-accent/20 transition-colors">
                <Icon
                  name="mdi:check"
                  class="w-4 h-4 text-accent"
                />
              </div>
              <p class="text-gray-300 font-body text-sm md:text-base leading-relaxed">
                {takeaway}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ==================== BOTTOM NAVIGATION ==================== -->
    <section class="max-w-5xl mx-auto px-4 mt-20 md:mt-28">
      <div class="cs-reveal">
        <div class="border-t border-white/10 pt-10 flex flex-col sm:flex-row items-center justify-between gap-6">
          <!-- Prev -->
          <div class="flex-1">
            {prevProject && (
              <a
                href={`/open-source/${prevProject.slug}`}
                class="group flex items-center gap-3 text-gray-400 hover:text-accent transition-colors"
              >
                <Icon
                  name="mdi:arrow-left"
                  class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
                />
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wider">Previous</p>
                  <p class="font-heading font-bold text-white group-hover:text-accent transition-colors">
                    {prevProject.title}
                  </p>
                </div>
              </a>
            )}
          </div>

          <!-- All Open Source Projects -->
          <a
            href="/#open-source"
            class="px-6 py-3 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300 hover:text-accent hover:border-accent/40 transition-all duration-300 flex items-center gap-2"
          >
            <Icon name="mdi:view-grid-outline" class="w-4 h-4" />
            All Open Source Projects
          </a>

          <!-- Next -->
          <div class="flex-1 text-right">
            {nextProject && (
              <a
                href={`/open-source/${nextProject.slug}`}
                class="group inline-flex items-center gap-3 text-gray-400 hover:text-accent transition-colors"
              >
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wider">Next</p>
                  <p class="font-heading font-bold text-white group-hover:text-accent transition-colors">
                    {nextProject.title}
                  </p>
                </div>
                <Icon
                  name="mdi:arrow-right"
                  class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                />
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FOOTER NAV ==================== -->
    <footer class="max-w-5xl mx-auto px-4 mt-16 pb-12">
      <div class="cs-reveal">
        <div class="border-t border-white/10 pt-10">
          <nav class="flex flex-wrap justify-center gap-x-10 gap-y-4">
            <a href="/#home" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:home" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Home
            </a>
            <a href="/#skills" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:code-tags" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Skills
            </a>
            <a href="/#career" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:work" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Career
            </a>
            <a href="/#projects" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:computer" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Case Studies
            </a>
            <a href="/#open-source" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:source-branch" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Open Source
            </a>
            <a href="/#contact" class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors duration-300 text-sm group">
              <Icon name="mdi:message" class="w-4 h-4 group-hover:scale-110 transition-transform" />
              Contact
            </a>
          </nav>

          <p class="text-center text-gray-600 text-xs mt-8 font-body">
            Andrei Botez &copy; {new Date().getFullYear()}
          </p>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
  /* Scroll-triggered reveal animations */
  .cs-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cs-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stats cards hover effect */
  .stats-card {
    transition: all 0.3s ease;
  }
  .stats-card:hover {
    border-color: rgba(164, 118, 255, 0.3);
    transform: translateY(-2px);
  }

  /* Hero section full bleed */
  .hero-section {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
</style>

<script>
  function initOssDetailReveals() {
    const elements = document.querySelectorAll(".cs-reveal");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.style.animationDelay
              ? parseInt(el.style.animationDelay)
              : 0;

            setTimeout(() => {
              el.classList.add("visible");
            }, delay);

            observer.unobserve(el);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -30px 0px",
      }
    );

    elements.forEach((el) => observer.observe(el));
  }

  // Run on load
  window.addEventListener("load", initOssDetailReveals);
  document.addEventListener("astro:after-swap", initOssDetailReveals);
  // Also run immediately for elements above the fold
  document.addEventListener("DOMContentLoaded", initOssDetailReveals);
</script>
