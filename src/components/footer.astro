---
import { personalInfo } from '../data/site/personal';
---

<footer class="py-8 px-4 md:px-0 border-t border-white/10">
  <div class="container mx-auto">
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-gray-500 text-xs font-body w-full leading-relaxed">
        The opinions expressed on this website are my own and do not necessarily reflect the views of my current or past employers.
      </p>
      <p class="text-gray-600 text-xs font-body">
        {personalInfo.name} &copy; {new Date().getFullYear()}
      </p>
    </div>
  </div>
</footer>
