---
import { Icon } from "astro-icon/components";
import { personalInfo } from '../data/site/personal';
import { withBase } from "../utils/url";

//Data Definitions
interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  intro: string;
  introHtml: string;
  resumeUrl: string;
  siteUrl: string;
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

const localData: ProfileData = {
  name: personalInfo.name,
  photoUrl: "profile_fixed.png",
  intro: "Fullstack engineer building secure, privacy-first software — from blockchain exchanges to loyalty platforms serving 1M+ users.",
  introHtml:
    "I <strong>design</strong>, <strong>build</strong>, <strong>operate</strong> and sometimes <strong>rescue</strong> web applications.<br /> Over the past decade I've migrated monoliths to microservices, built open-source tools, and scaled platforms across enterprise and startup environments.",
  resumeUrl: personalInfo.cv_pdf,
  siteUrl: personalInfo.site_url,
  socials: [
    { name: "GitHub", url: personalInfo.github, icon: "mdi:github" },
    { name: "LinkedIn", url: personalInfo.linkedin, icon: "mdi:linkedin" },
    { name: "Email", url: `mailto:${personalInfo.email}`, icon: "mdi:email" },
    { name: "Signal", url: `sgnl://signal.me/#u/${personalInfo.signal}`, icon: "simple-icons:signal" },
    { name: "PGP", url: personalInfo.pgp_key_url, icon: "mdi:key" },
  ].filter((s) => !!s.url),
};

let data: ProfileData = localData;

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error("Network response was not ok");
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
  }
}

const { name, photoUrl, intro, introHtml, resumeUrl, siteUrl, socials } = data;
const profilePhotoUrl = withBase(photoUrl);
const placeholderUrl = withBase('/placeholder.jpeg');
---

<section
  id="home"
  class="flex flex-col items-center justify-center pt-10 pb-10 md:pt-20 md:pb-16 gap-1 min-h-[90vh] text-center"
>
  <div
    class="relative group mb-2 reveal-content"
    style="animation-delay: 100ms;"
  >
    <div
      class="balloon-float w-36 h-36 md:w-44 md:h-44 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_rgba(164,118,255,0.2)] bg-transparent"
    >
      <img
        src={profilePhotoUrl}
        alt={name}
        loading="eager"
        decoding="async"
        onerror={`this.onerror=null;this.src='${placeholderUrl}';`}
        class="w-full h-full object-cover object-top"
      />
    </div>
    <div
      class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"
    >
    </div>
  </div>

  <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-accent/80 leading-relaxed tracking-wide text-sm uppercase">Fullstack Software Developer</p>
  </div>

  <div
    class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content"
    style="animation-delay: 300ms;"
  >
    <h1
      class="text-5xl md:text-7xl font-heading font-bold text-white tracking-tight"
    >
      {name}
    </h1>
    <br />
    <p
      class="text-gray font-body text-lg leading-relaxed"
      set:html={introHtml}
    />
  </div>

  <div class="mt-8 mb-4 flex flex-col sm:flex-row gap-4 items-center reveal-content" style="animation-delay: 400ms;">
    <a
      href={resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative inline-flex items-center justify-center px-10 py-3 bg-accent/10 border border-accent/50 rounded-full text-white font-body transition-all duration-300
             shadow-[0_0_20px_rgba(var(--accent-rgb),0.2)]
             hover:bg-accent/20 hover:shadow-[0_0_30px_rgba(var(--accent-rgb),0.35)]
             hover:scale-105"
    >
      <span class="tracking-wide text-sm md:text-base font-medium">View my CV</span>
      <div
        class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      ></div>
    </a>
  </div>

  <div class="flex gap-6 mt-4 reveal-content" style="animation-delay: 500ms;">
    {
      socials.map((social) => (
        <a
          href={social.url}
          target={social.name === "Signal" ? "_self" : "_blank"}
          rel="noopener noreferrer"
          aria-label={social.name}
          data-copy={social.name === "Signal" ? personalInfo.signal : null}
          class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110 contact-card"
        >
          <Icon
            name={social.icon}
            class="w-8 h-8 text-white group-hover:text-accent transition-colors duration-300"
            aria-hidden="true"
          />

          <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body" aria-hidden="true">
            {social.name}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* profile photo floating animation */

  /* When combined, the animation rule automatically merges these transforms */
  .avatar-container {
    animation:
      float 5s ease-in-out infinite alternate,
      wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    will-change: transform;
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      /* Moves up and slightly right */
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      /* Drifts left and stays elevated */
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      /* Returns to start */
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>

<script>
  function initHome() {
    function revealSkills() {
      const cards = document.querySelectorAll(".skill-card");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Add a slight delay based on the card's position to create a wave effect
              const index = Array.from(cards).indexOf(entry.target);
              setTimeout(
                () => {
                  entry.target.classList.add("reveal");
                },
                (index % 6) * 50,
              ); // Delay resets every row for a clean staggered look

              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1, // Trigger when 10% of the card is visible
          rootMargin: "0px 0px -50px 0px", // Trigger slightly before it hits the viewport
        },
      );

      cards.forEach((card) => observer.observe(card));
    }

    // Copy functionality
    const cards = document.querySelectorAll('.contact-card[data-copy]');
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const text = card.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text).then(() => {
            const span = card.querySelector('span[aria-hidden="true"]');
            if (span) {
              const original = span.textContent;
              span.textContent = 'ID Copied!';
              span.classList.add('text-accent');
              
              setTimeout(() => {
                span.textContent = original;
                span.classList.remove('text-accent');
              }, 2000);
            }
          });
        }
      });
    });

    revealSkills();
  }

  // Support for Astro View Transitions
  document.addEventListener('astro:page-load', initHome);
  // Initial load
  initHome();
</script>
