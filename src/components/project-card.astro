---
import { Icon } from 'astro-icon/components';
const { project } = Astro.props;
---

<div class="project-card group relative flex flex-col h-full bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500">
  
  <div class="h-32 w-full relative overflow-hidden bg-[#1a1a1a] flex-shrink-0">
    <div class="absolute inset-0 bg-accent/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
    
    <div class="w-full h-full relative">
      <!-- Fallback safely handles missing image arrays -->
      <img 
        src={project.caseStudy?.heroImage || '/placeholder.jpeg'} 
        alt={`${project.title} cover`}
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/placeholder.jpeg';"
        class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110 z-0 opacity-100"
      />
    </div>
    
    {project.platforms && (
      <div class="absolute top-3 right-3 flex gap-2 z-20">
        {project.platforms.map((p) => (
          <div class="p-1.5 bg-black/60 backdrop-blur-md rounded-lg border border-white/10 text-white/80">
            <Icon name={`mdi:${p}`} class="w-4 h-4" />
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="p-6 flex flex-col flex-grow space-y-4">
    
    <div class="flex justify-between items-start">
      <div>
        <div class="flex flex-wrap gap-2 mb-1">
          {project.category.map((cat) => (
            <span class="text-accent text-[10px] uppercase tracking-widest font-bold">{cat}</span>
          ))}
        </div>
        <h3 class="text-xl font-heading font-bold text-white mt-1">{project.title}</h3>
      </div>
      {project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-white/40 hover:text-accent transition-colors flex-shrink-0 mt-1 text-xs font-bold" aria-label={`Visit ${project.title}`}>
          <span>View</span>
          <Icon name="mdi:open-in-new" class="w-4 h-4" />
        </a>
      )}
    </div>

    <!-- Expandable Description Section -->
    <div class="description-container relative flex-grow flex flex-col">
      <div class="text-gray-400 text-sm font-body line-clamp-3 transition-all duration-300 description-content w-full whitespace-pre-wrap">{project.caseStudy?.overview || (Array.isArray(project.description) ? project.description.join('\n') : project.description)}</div>
      <button 
        class="read-more-btn mt-2 inline-block text-left text-accent text-xs font-bold hover:underline bg-transparent border-none cursor-pointer w-max"
        aria-expanded="false"
      >
        Read more
      </button>
    </div>

    <!-- Tech Stack -->
    <div class="flex flex-wrap gap-2 pt-2 mt-auto">
      {project.tech && project.tech.map((t) => (
        <span class="px-2 py-1 bg-white/5 rounded-md text-[10px] text-white/60 border border-white/5">
          {t}
        </span>
      ))}
    </div>

    <!-- Case Study CTA -->
    {project.caseStudy && (
      <a
        href={`/case-study/${project.caseStudy.slug}`}
        class="mt-4 inline-flex items-center gap-2 text-accent text-sm font-bold hover:gap-3 transition-all duration-300 group/cta"
        aria-label={`View detailed case study for ${project.title}`}
      >
        <span>View Case Study</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover/cta:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    )}
  </div>
</div>

<script>
  function initReadMore() {
    const btns = document.querySelectorAll('.read-more-btn');
    
    btns.forEach(btn => {
      if(btn.getAttribute('data-init')) return;
      btn.setAttribute('data-init', 'true');

      // We wrap height calculation in setTimeout so fonts load
      setTimeout(() => {
        const container = btn.previousElementSibling as HTMLElement;
        // Check if content is actually overflowing
        if (container.scrollHeight <= container.clientHeight + 2) {
          (btn as HTMLElement).style.display = 'none';
        }
      }, 200);

      btn.addEventListener('click', (e) => {
        const button = e.target as HTMLButtonElement;
        const container = button.previousElementSibling as HTMLElement;
        if (container.classList.contains('line-clamp-3')) {
          container.classList.remove('line-clamp-3');
          button.textContent = 'Show less';
          button.setAttribute('aria-expanded', 'true');
        } else {
          container.classList.add('line-clamp-3');
          button.textContent = 'Read more';
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }

  // Ensure scripts run properly with normal and Astro loads
  window.addEventListener('load', initReadMore);
  document.addEventListener('astro:page-load', initReadMore);
  document.addEventListener('astro:after-swap', initReadMore);
</script>

<style is:global>
  .project-card {
    transition: 
      opacity 0.8s ease-out, 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .js .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
  }

  .js .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>