---
import { Icon } from "astro-icon/components";
import { personalInfo } from '../data/site/personal';

const socials = [
  { name: "GitHub", url: personalInfo.github, icon: "mdi:github" },
  { name: "LinkedIn", url: personalInfo.linkedin, icon: "mdi:linkedin" },
  { name: "Email", url: `mailto:${personalInfo.email}`, icon: "mdi:email" },
  { name: "Signal", url: `sgnl://signal.me/#u/${personalInfo.signal}`, icon: "simple-icons:signal" },
  { name: "PGP", url: personalInfo.pgp_key_url, icon: "mdi:key" },
  { name: "Personal Page", url: personalInfo.website, icon: "mdi:web" },
].filter((s) => !!s.url);
---

<section id="contact" class="py-4 md:py-20 px-4 md:px-0">
  <div class="container mx-auto">
    <div class="contact-reveal space-y-12">
      <div class="mb-16">
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4"
        >
          <span class="text-accent">/</span> Contact Me
        </h2>
        <p class="text-gray font-body text-sm max-w-md">
          Open to new opportunities. Let's talk.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 text-center"
      >
        {
          socials.map((social) => (
            <a
              href={social.url}
              target={social.name === "Signal" ? "_self" : "_blank"}
              data-copy={social.name === "Signal" ? personalInfo.signal : null}
              class="contact-card group p-8 bg-white/5 border border-white/10 rounded-3xl hover:border-accent/40 hover:bg-accent/5 transition-all duration-300"
            >
              <Icon
                name={social.icon}
                class="w-10 h-10 text-accent mb-4 mx-auto group-hover:scale-110 transition-transform"
              />
              <h3 class="text-white font-bold mb-1">{social.name}</h3>
              <p class="text-gray-400 text-xs truncate px-2 transition-colors">
                {social.name === "Signal"
                  ? personalInfo.signal
                  : social.name === "PGP"
                    ? personalInfo.pgp_fingerprint
                    : social.url
                        .replace("https://", "")
                        .replace("mailto:", "")
                        .replace("wa.me/", "+")}
              </p>
            </a>
          ))
        }
      </div>

      <!-- /* FOOTER */ -->
      <div class="pt-16 border-t border-white/10">
        <div class="flex flex-col items-center gap-3 text-center">
          <p class="text-gray-500 text-xs font-body w-full leading-relaxed">
            The opinions expressed on this website are my own and do not necessarily reflect the views of my current or past employers.
          </p>
          <p class="text-gray-600 text-xs font-body">
            {personalInfo.name} &copy; {new Date().getFullYear()}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initContact() {
    // Reveal animation
    const revealContact = () => {
      const section = document.querySelector(".contact-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("reveal");
          });
        },
        { threshold: 0.1 },
      );
      if (section) observer.observe(section);
    };

    // Copy functionality
    const cards = document.querySelectorAll('.contact-card[data-copy]');
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const text = card.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text).then(() => {
            const p = card.querySelector('p');
            if (p) {
              const original = p.textContent;
              p.textContent = 'ID Copied!';
              p.classList.add('text-accent');
              p.classList.remove('text-gray-400');
              
              setTimeout(() => {
                p.textContent = original;
                p.classList.remove('text-accent');
                p.classList.add('text-gray-400');
              }, 2000);
            }
          });
        }
      });
    });

    revealContact();
  }

  // Support for Astro View Transitions
  document.addEventListener('astro:page-load', initContact);
  // Initial load
  initContact();
</script>

<style>
  .contact-reveal {
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .contact-reveal {
    opacity: 0;
    transform: translateY(30px);
  }

  :global(.js) .contact-reveal.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>
