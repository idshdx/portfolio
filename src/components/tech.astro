---
import { Icon } from "astro-icon/components";
import { skills } from '../data/site/skills';

interface Skill {
  name: string;
  icon: string;
}

interface Category {
  title: string;
  icon: string;
  skills: Skill[];
}

const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
let categories: Category[];

// Helper to avoid duplicate names and assign icons consistently
const mapSkills = (arr: string[] | undefined, defaultIcon: string) => {
  return (arr || []).map((s) => ({ name: s, icon: defaultIcon }));
};

const localTechData: { categories: Category[] } = {
  categories: [
    {
      title: "Domain Skills",
      icon: "mdi:briefcase-outline",
      skills: [...mapSkills(skills.domainSkills, "mdi:check-circle-outline")],
    },
    {
      title: "Languages & Frameworks",
      icon: "mdi:code-braces",
      skills: [
        ...mapSkills(skills.programmingLanguages, "mdi:language-typescript"),
        ...mapSkills(skills.javascriptFrameworks, "mdi:hexagon"),
        ...mapSkills(skills.otherFrameworks, "mdi:puzzle-outline"),
      ],
    },
    {
      title: "Data & Servers",
      icon: "mdi:database",
      skills: [
        ...mapSkills(skills.databaseAndStorage, "mdi:database-outline"),
        ...mapSkills(skills.webAndApplicationServers, "mdi:server"),
      ],
    },
    {
      title: "Infrastructure & OS",
      icon: "mdi:cloud",
      skills: [
        ...mapSkills(skills.cloudProviders, "mdi:cloud-outline"),
        ...mapSkills(skills.virtualization, "mdi:docker"),
        ...mapSkills(skills.operatingSystems, "mdi:linux"),
      ],
    },
    {
      title: "DevOps & Testing",
      icon: "mdi:shield-check",
      skills: [
        ...mapSkills(skills.automationBuildTools, "mdi:robot"),
        ...mapSkills(skills.testingTools, "mdi:test-tube"),
        ...mapSkills(skills.monitoringLoggingTools, "mdi:chart-line"),
      ],
    },
  ],
};

try {
  if (BASE_URL) {
    const response = await fetch(`${BASE_URL}/tech`);
    const data = await response.json();
    categories = data.categories || localTechData.categories;
  } else {
    categories = localTechData.categories;
  }
} catch {
  categories = localTechData.categories;
}
---

<section id="skills" class="py-12 md:py-24 px-4 md:px-0 overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16 max-w-2xl">
      <h2
        class="text-3xl md:text-4xl font-heading font-bold text-white mb-4 flex items-center gap-4"
      >
        <span class="text-accent">/</span> Skills
      </h2>
      <p class="text-gray font-body text-base/relaxed">
        An overview of my technical expertise and services offering, ranging from
        frontend architecture to cloud infrastructure and secure deployments.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
      {
        categories.map((category) => (
          <div
            class={`domain-card group relative p-6 md:p-8 rounded-2xl bg-white/5 border border-white/10 hover:border-accent/40 transition-all duration-500 overflow-hidden ${category.title === "Domain Skills" ? "lg:col-span-2" : ""}`}
          >
            {/* Subtle gradient background effect on hover */}
            <div class="absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

            <div class="relative z-10">
              <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-background transition-colors duration-300 shadow-lg">
                  <Icon name={category.icon} class="w-6 h-6" />
                </div>
                <h3 class="text-xl font-heading font-semibold text-white/90">
                  {category.title}
                </h3>
              </div>

              <div class="flex flex-wrap gap-2.5">
                {category.skills.map((skill) => (
                  <div class="skill-pill opacity-0 translate-y-4 flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 hover:border-accent/50 hover:bg-white/10 transition-all duration-300 cursor-default shadow-sm">
                    <Icon
                      name={skill.icon}
                      class="w-4 h-4 text-white/50 group-hover:text-accent transition-colors"
                    />
                    <span class="text-[13px] font-body text-white/80 whitespace-nowrap tracking-tight">
                      {skill.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Base state for animations */
  .skill-pill {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .domain-card {
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.5s,
      background-color 0.5s;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .domain-card:hover {
    box-shadow: 0 10px 40px rgba(var(--color-accent), 0.05);
    transform: translateY(-2px);
  }

  /* Revealed state */
  .skill-pill.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  function initTechAnimations() {
    const cards = document.querySelectorAll(".domain-card");

    // Animate pills staggering locally within each card
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target;
            const pills = card.querySelectorAll(".skill-pill");

            pills.forEach((pill, idx) => {
              setTimeout(() => {
                pill.classList.add("reveal");
              }, idx * 30); // 30ms stagger per pill
            });

            observer.unobserve(card);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    cards.forEach((card) => observer.observe(card));
  }

  // Runs on initial load
  initTechAnimations();

  // Necessary for Astro View Transitions if you use them
  document.addEventListener("astro:after-swap", initTechAnimations);
</script>
