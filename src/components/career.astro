---
import { milestones } from '../data/site/milestones';
import { withBase } from '../utils/url';
---

<section id="career" class="py-20 px-4 md:px-0 max-w-6xl mx-auto overflow-hidden">
  <div class="container mx-auto reveal-content" style="animation-delay: 1000ms;">
    <div>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> Key moments that shaped my journey
      </h2>
      <p class="text-gray font-body text-sm max-w-lg pb-8">
        From my first computer to building a consulting business
      </p>
    </div>

    <div class="relative">
      {/* Vertical Line */}
      <div class="absolute left-2 md:left-1/2 md:-translate-x-1/2 top-5 bottom-0 w-0.5 bg-linear-to-b from-accent via-white/10 to-transparent"></div>

      {/* Mobile layout */}
      <div class="md:hidden space-y-8">
        {milestones.map((item, index) => (
          <div class="relative pl-6">
            {/* Dot */}
            <div class="scroll-stat absolute left-0 top-[14px] z-10">
              <div class={`w-4 h-4 rounded-full border-4 border-[#0a0a0a]
                          ${index === 0 ? 'bg-accent shadow-[0_0_15px_#a476ff] animate-pulse' : 'bg-gray-600'}`}>
              </div>
            </div>

            {/* Card */}
            <div class="scroll-stat bg-white/5 border border-white/10 p-4 rounded-2xl text-left">
              <span class="text-accent font-mono text-xs tracking-widest uppercase">{item.year}</span>
              <h3 class="text-xl font-heading font-bold text-white mt-1 mb-3">{item.title}</h3>
              {item.photo && (
                <img
                  src={withBase(item.photo)}
                  alt={item.title}
                  class="w-full h-auto rounded-xl mb-4 opacity-80"
                />
              )}
              <p class="text-gray-400 font-body text-sm leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Desktop alternating layout */}
      <div class="hidden md:block space-y-4">
        {milestones.map((item, index) => (
          <div class="relative grid grid-cols-2">
            {/* Center Dot */}
            <div class="scroll-stat absolute left-1/2 -translate-x-1/2 top-[22px] z-10">
              <div class={`w-4 h-4 rounded-full border-4 border-[#0a0a0a]
                          ${index === 0 ? 'bg-accent shadow-[0_0_15px_#a476ff] animate-pulse' : 'bg-gray-600'}`}>
              </div>
            </div>

            {/* Left side (even items) */}
            <div class="md:px-6 md:py-0">
              {index % 2 === 0 ? (
                <div class="scroll-stat bg-white/5 border border-white/10 p-6 rounded-2xl text-left hover:border-accent/30 transition-all group">
                  <span class="text-accent font-mono text-xs tracking-widest uppercase">{item.year}</span>
                  <h3 class="text-xl font-heading font-bold text-white mt-1 mb-3">{item.title}</h3>
                  {item.photo && (
                    <img
                      src={withBase(item.photo)}
                      alt={item.title}
                      class="w-full h-auto rounded-xl mb-4 opacity-80"
                    />
                  )}
                  <p class="text-gray-400 font-body text-sm leading-relaxed">{item.description}</p>
                </div>
              ) : <div class="h-full pointer-events-none"></div>}
            </div>

            {/* Right side (odd items) */}
            <div class="md:px-6 md:py-0">
              {index % 2 !== 0 ? (
                <div class="scroll-stat bg-white/5 border border-white/10 p-6 rounded-2xl hover:border-accent/30 transition-all group">
                  <span class="text-accent font-mono text-xs tracking-widest uppercase">{item.year}</span>
                  <h3 class="text-xl font-heading font-bold text-white mt-1 mb-3">{item.title}</h3>
                  {item.photo && (
                    <img
                      src={withBase(item.photo)}
                      alt={item.title}
                      class="w-full h-auto rounded-xl mb-4 opacity-80"
                    />
                  )}
                  <p class="text-gray-400 font-body text-sm leading-relaxed">{item.description}</p>
                </div>
              ) : <div class="h-full pointer-events-none"></div>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>


<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .scroll-stat {
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }

  :global(.js) .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>


<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150);

          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  document.addEventListener('astro:after-swap', revealCards);
</script>
