---
import { interests } from "../data";
import type { InterestLabel } from "../data";

// Color mapping for interest labels
const labelColors: Record<InterestLabel, { bg: string; text: string; border: string; glow: string }> = {
  Core: {
    bg: "bg-accent/15",
    text: "text-accent",
    border: "border-accent/30",
    glow: "shadow-[0_0_12px_rgba(164,118,255,0.15)]",
  },
  Active: {
    bg: "bg-emerald-500/15",
    text: "text-emerald-400",
    border: "border-emerald-500/30",
    glow: "shadow-[0_0_12px_rgba(52,211,153,0.15)]",
  },
  Exploring: {
    bg: "bg-sky-500/15",
    text: "text-sky-400",
    border: "border-sky-500/30",
    glow: "shadow-[0_0_12px_rgba(56,189,248,0.15)]",
  },
  Old: {
    bg: "bg-gray-500/15",
    text: "text-gray-400",
    border: "border-gray-500/30",
    glow: "",
  },
};

// Show the latest (non-Old) interests
const latestInterests = interests.filter((i) => i.label !== "Old").slice(0, 4);
---

<section id="interests" class="py-12 md:py-24 px-4 md:px-0 overflow-hidden relative">
  <!-- Background Glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/4 rounded-full blur-[100px] pointer-events-none"
  ></div>

  <div class="container mx-auto relative z-10">
    <div class="interests-reveal opacity-0">
      <!-- Section Header (matches Contact Me / Featured Projects style) -->
      <div class="mb-16">
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4"
        >
          <span class="text-accent">/</span> Latest Interests
        </h2>
        <p class="text-gray font-body text-sm max-w-md">
          The topics and technologies I'm currently exploring, actively working
          with, or consider fundamental to my craft.
        </p>
      </div>

      <!-- Interest Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          latestInterests.map((interest) => {
            const colors = labelColors[interest.label];
            return (
              <div class={`interest-card group relative p-6 rounded-2xl border border-white/8 bg-white/[0.03] backdrop-blur-sm hover:border-accent/25 hover:bg-white/[0.05] transition-all duration-500 ${colors.glow}`}>
                {/* Label Badge */}
                <div class="flex items-center justify-between mb-4">
                  <span
                    class={`inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wider uppercase px-3 py-1 rounded-full border ${colors.bg} ${colors.text} ${colors.border}`}
                  >
                    <span class="relative flex h-1.5 w-1.5">
                      <span
                        class={`absolute inline-flex h-full w-full rounded-full opacity-60 ${interest.label === "Core" || interest.label === "Active" ? "animate-ping" : ""} ${colors.bg}`}
                      />
                      <span
                        class={`relative inline-flex rounded-full h-1.5 w-1.5 ${colors.text.replace("text-", "bg-")}`}
                      />
                    </span>
                    {interest.label}
                  </span>
                </div>

                {/* Content */}
                <h3 class="text-lg font-heading font-semibold text-white mb-2 group-hover:text-accent/90 transition-colors duration-300">
                  {interest.title}
                </h3>
                <p class="text-gray-400 text-sm font-body leading-relaxed">
                  {interest.description}
                </p>

                {/* Hover border glow effect */}
                <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none border border-accent/10" />
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .interests-reveal {
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .interests-reveal.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .interest-card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.5s ease,
      background-color 0.5s ease,
      box-shadow 0.5s ease;
  }
  .interests-reveal.reveal .interest-card {
    opacity: 1;
    transform: translateY(0);
  }
  .interests-reveal.reveal .interest-card:nth-child(1) {
    transition-delay: 0.05s;
  }
  .interests-reveal.reveal .interest-card:nth-child(2) {
    transition-delay: 0.15s;
  }
  .interests-reveal.reveal .interest-card:nth-child(3) {
    transition-delay: 0.25s;
  }
  .interests-reveal.reveal .interest-card:nth-child(4) {
    transition-delay: 0.35s;
  }
</style>

<script>
  const revealInterests = () => {
    const section = document.querySelector(".interests-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("reveal");
        });
      },
      { threshold: 0.1 },
    );
    if (section) observer.observe(section);
  };
  revealInterests();
  document.addEventListener("astro:after-swap", revealInterests);
</script>
