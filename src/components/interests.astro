---
import { Icon } from "astro-icon/components";

const pillars = [
  {
    icon: "mdi:code-braces-box",
    title: "What I Build",
    body: "Fullstack web systems — backend-heavy with NestJS, Node.js, and TypeScript, deployed on AWS and Azure. I specialize in migrating legacy monoliths to cloud-native microservices, building secure APIs, and shipping developer tooling. On the side, I contribute to free open source privacy enhancing technologies.",
  },
  {
    icon: "mdi:shield-lock-outline",
    title: "What I Care About",
    body: "Privacy-first design, software security, and developer experience are the threads that connect my work. I run hardened OS stacks — QubesOS, GrapheneOS, NixOS — for daily use and research. I'm drawn to protocols, AI and thinking about technical design problems.",
  },
  {
    icon: "mdi:compass-outline",
    title: "What I'm Looking For",
    body: "Roles where security, privacy, or developer experience are first-class concerns — ideally remote, with an engineering-led culture. I thrive in teams that value positive intent, technical depth, and treat excelence as a must.",
    isPlaceholder: true,
  },
];
---

<section id="about" class="py-12 md:py-24 px-4 md:px-0 overflow-hidden relative">
  <!-- Background Glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/4 rounded-full blur-[100px] pointer-events-none"
  ></div>

  <div class="container mx-auto relative z-10">
    <div class="about-reveal">
      <!-- Section Header -->
      <div class="mb-16">
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4"
        >
          <span class="text-accent">/</span> About
        </h2>
        <p class="text-gray font-body text-sm max-w-lg">
          The short version — what I do and how can I help you, what drives me and what's next.
        </p>
      </div>

      <!-- Pillar Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          pillars.map((pillar, i) => (
            <div class={`about-card group relative p-7 rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm hover:border-accent/25 hover:bg-white/5 transition-all duration-500`}>
              {/* Icon */}
              <div class="mb-5 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center shrink-0">
                  <Icon name={pillar.icon} class="w-5 h-5 text-accent" />
                </div>
                <h3 class="text-lg font-heading font-semibold text-white group-hover:text-accent/90 transition-colors duration-300">
                  {pillar.title}
                </h3>
              </div>

              {/* Body */}
              <p class="text-gray-400 text-sm font-body leading-relaxed" set:html={pillar.body} />

              {/* Placeholder badge */}
              {pillar.isPlaceholder && (
                <div class="mt-4 inline-flex items-center gap-1.5 text-[10px] font-medium tracking-wider uppercase px-3 py-1 rounded-full border bg-amber-500/10 text-amber-400 border-amber-500/25">
                  <span class="relative flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full rounded-full opacity-60 animate-ping bg-amber-500/40" />
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-400" />
                  </span>
                  Contact me for a CV
                </div>
              )}

              {/* Hover border glow */}
              <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none border border-accent/10" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-reveal {
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .about-reveal {
    opacity: 0;
    transform: translateY(30px);
  }

  :global(.js) .about-reveal.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .about-card {
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.5s ease,
      background-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  :global(.js) .about-card {
    opacity: 0;
    transform: translateY(20px);
  }

  :global(.js) .about-reveal.reveal .about-card {
    opacity: 1;
    transform: translateY(0);
  }
  .about-reveal.reveal .about-card:nth-child(1) {
    transition-delay: 0.05s;
  }
  .about-reveal.reveal .about-card:nth-child(2) {
    transition-delay: 0.15s;
  }
  .about-reveal.reveal .about-card:nth-child(3) {
    transition-delay: 0.25s;
  }
</style>

<script>
  const revealAbout = () => {
    const section = document.querySelector(".about-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("reveal");
        });
      },
      { threshold: 0.1 },
    );
    if (section) observer.observe(section);
  };
  revealAbout();
  document.addEventListener("astro:after-swap", revealAbout);
</script>
