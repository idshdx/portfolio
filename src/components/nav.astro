---
import { Icon } from "astro-icon/components";
import { withBase } from "../utils/url";
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Intro",
    href: "/#home",
    icon: `mdi:home`,
  },
  {
    label: "Skills",
    href: "/#skills",
    icon: `mdi:code-tags`,
  },
  {
    label: "Milestones",
    href: "/#career",
    icon: `mdi:timeline-clock-outline`,
  },
  {
    label: "Cases",
    href: "/#projects",
    icon: `mdi:computer`,
  },
  {
    label: "Projects",
    href: "/#open-source",
    icon: "mdi:source-branch",
  },
  {
    label: "Testimonials",
    href: "/#testimonials",
    icon: "mdi:format-quote-close",
  },
  // {
  //   label: "Education",
  //   href: "/#contact",
  //   icon: `mdi:message`,
  // },
  {
    label: "About",
    href: "/#about",
    icon: `mdi:account-outline`,
  },
  {
    label: "Contact",
    href: "/#contact",
    icon: `mdi:message`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    aria-label="Main Navigation"
    class="fixed left-1/2 -translate-x-1/2 z-20 border-[1.2px] border-transparent transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[95%] md:w-[80%]"
  >
    <div
      class="flex justify-center items-center p-3 reveal-content"
      style="animation-delay: 700ms;"
    >
      <ul
        role="list"
        class="flex w-full justify-between md:justify-center md:gap-4 lg:gap-8 xl:gap-12 gap-1"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={withBase(item.href)}
                class="flex flex-col items-center gap-1 text-gray-400 transition-colors text-xs md:text-base relative group"
              >
                <div class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 nav-indicator hidden md:block" />
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <Icon
                    name={item.icon}
                    class="nav-icon w-full h-full text-gray-400 group-hover:text-accent transition-colors duration-300"
                  />
                </span>
                <span class="hidden md:inline-block">{item.label}</span>
                <span class="md:hidden text-xs">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>
<style>
  /* Reveal whole section when website loads */
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  nav {
    background-color: transparent;
    border-color: transparent;
    backdrop-filter: blur(0px);
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      border-radius 0.4s ease,
      border-color 0.4s ease,
      width 0.4s ease;
  }

  nav.scrolling {
    background-color: color-mix(
      in srgb,
      var(--color-background),
      transparent 75%
    );
    border-color: #ffffff20;
    border-radius: 9999px;
    backdrop-filter: blur(10px);
    width: max-content !important;
    max-width: 95vw;
  }

  nav a.active .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 0;
  }

  /* Base state for the link text */
  nav a {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      font-weight 0.3s ease;
  }

  /* Active state */
  nav a.active {
    color: white !important;
    font-weight: 700;
    transform: scale(1.1);
  }

  /* Glow effect */
  nav a.active span {
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  /* Ensure the scale doesn't jitter the layout */
  nav li {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Icon style for mobile view */
  .nav-icon {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      filter 0.3s ease;
  }

  nav a.active .nav-icon {
    color: var(--color-accent) !important;
    transform: scale(1.2);
    filter: drop-shadow(0 0 8px var(--color-accent));
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      bottom: 0;
      border-radius: 1.5rem 1.5rem 0 0;
      background-color: color-mix(
        in srgb,
        var(--color-background),
        transparent 10%
      );
      backdrop-filter: blur(10px);
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    nav.scrolling {
      border-radius: 1.5rem 1.5rem 0 0;
      width: 100% !important;
    }

    /* Hiding bottom bar while scroling on mobile */
    #main-nav {
      /* Force Hardware Acceleration (Fixes the white flash) */
      will-change: transform;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;

      /* Smooth transition */
      transition:
        transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        background-color 0.4s ease,
        backdrop-filter 0.4s ease;

      /* Ensure no default background is fighting the blur */
      background-clip: padding-box;
    }

    #main-nav.nav-hidden {
      transform: translateY(110%) !important;

      /* Optional: Turn off blur when hidden to save GPU cycles */
      backdrop-filter: blur(0px);
    }
  }

  /* Hover effect */
  nav a:not(.active):hover {
    color: var(--color-accent) !important;
  }

  nav a:not(.active):hover span {
    transform: scale(0.95);
    text-shadow: 0 0 15px var(--color-accent-60);
  }

  nav a:not(.active):hover .nav-icon {
    transform: scale(0.95);
    color: var(--color-accent) !important;
  }
</style>

<script>
  //scroll morphing effect, changing width & border radius
  const nav = document.getElementById("main-nav");
  let lastScrollY = window.scrollY;
  let rafId: number | null = null;

  function updateNav() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 0) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
    if (window.innerWidth < 768) {
      // Small buffer (e.g. 10px) to prevent accidental hiding on "jittery" scrolls
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        // Scrolling Down - Hide Nav
        nav?.classList.add("nav-hidden");
      } else {
        // Scrolling Up - Show Nav
        nav?.classList.remove("nav-hidden");
      }
    }

    lastScrollY = currentScrollY;
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true },
  );

  //smooth scrolling to a linked section
  document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const target = e.currentTarget as HTMLAnchorElement;
      const href = target.getAttribute("href") || "";
      
      const destination = new URL(href, window.location.href);
      const currentPath = window.location.pathname.replace(/\/index\.html$/, "/");
      const destinationPath = destination.pathname.replace(/\/index\.html$/, "/");

      // Only smooth scroll if we are on the same page
      if (href.startsWith("#") || destinationPath === currentPath) {
        const targetId = destination.hash.slice(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({
            behavior: "smooth",
          });
          // Move keyboard focus to the target section for accessibility
          if (!targetElement.hasAttribute('tabindex')) {
            targetElement.setAttribute('tabindex', '-1');
            targetElement.style.outline = 'none';
          }
          targetElement.focus({ preventScroll: true });
          
          // If we are on mobile, hide the nav after clicking
          if (window.innerWidth < 768) {
             const nav = document.getElementById("main-nav");
             nav?.classList.add("nav-hidden");
          }
        }
      }
    });
  });

  //highlight section by observing visible one on the screen
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href*='#']");
    
    // Wider rootMargin and multiple thresholds for better coverage
    const observerOptions = { 
      threshold: [0, 0.1, 0.2, 0.3, 0.5],
      rootMargin: "-20% 0px -30% 0px" 
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      // We want to find the section that is most "active" in our target zone
      let activeId = "";

      // Check if we are at the very top of the page
      if (window.scrollY < 100) {
        activeId = "home";
      } 
      // Check if we are at the very bottom of the page
      else if ((window.innerHeight + Math.round(window.scrollY)) >= document.body.offsetHeight - 50) {
        activeId = "contact";
      }
      else {
        // Find the section currently intersecting
        const intersecting = Array.from(sections).filter(section => {
          const rect = section.getBoundingClientRect();
          // A section is "active" if its top is in the top half of the screen
          // or if it covers the top half.
          return rect.top < window.innerHeight * 0.4 && rect.bottom > window.innerHeight * 0.2;
        });

        if (intersecting.length > 0) {
          // Pick the one that is closest to the top of our "active zone"
          intersecting.sort((a, b) => {
            const rectA = a.getBoundingClientRect();
            const rectB = b.getBoundingClientRect();
            return Math.abs(rectA.top) - Math.abs(rectB.top);
          });
          activeId = intersecting[0].getAttribute("id") || "";
        }
      }

      if (activeId) {
        navLinks.forEach((link) => {
          const href = link.getAttribute("href");
          if (href?.includes(`#${activeId}`)) {
            link.classList.add("active");
          } else {
            link.classList.remove("active");
          }
        });
      }
    };

    // Use scroll event as fallback/supplement for more immediate feedback
    window.addEventListener("scroll", () => {
      // Throttled check could be added here, but let's try direct first
      observerCallback([]); 
    }, { passive: true });

    // Initial check
    observerCallback([]);
  });
</script>

<style>
  @media (max-width: 767px) {
    body {
      padding-bottom: 70px;
    }
  }

  nav a.active {
    color: white !important;
  }
</style>
